{
  "name": "jungle-backend-challenge",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.x"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "setup": "bun run scripts/setup.ts",
    "migrate": "bun run src/migrate.ts up",
    "migrate:down": "bun run src/migrate.ts down",
    "test": "bun test",
    "test:integration": "bun run scripts/integration.ts",
    "test:unit": "bun test tests/unit",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "demo:money": "bun run examples/money.ts",
    "demo:http": "bun run scripts/demo-http.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1162.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
